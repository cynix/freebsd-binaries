@@ -0,0 +1,68 @@
+package docker
+
+import (
+	"context"
+	"net"
+	"reflect"
+	"testing"
+
+	"github.com/docker/docker/api/types/container"
+	"github.com/docker/docker/api/types/network"
+)
+
+func TestGenerateAllNetworks(t *testing.T) {
+	inspect := container.InspectResponse{
+		ContainerJSONBase: &container.ContainerJSONBase{
+			Name: "/web",
+			HostConfig: &container.HostConfig{
+				NetworkMode: container.NetworkMode("missing-primary"),
+			},
+		},
+		Config: &container.Config{Labels: map[string]string{}},
+		NetworkSettings: &container.NetworkSettings{
+			Networks: map[string]*network.EndpointSettings{
+				"frontend": {IPAddress: "10.88.0.10", Aliases: []string{"public"}},
+				"backend":  {IPAddress: "10.89.0.10", GlobalIPv6Address: "2001:db8::10", Aliases: []string{"private"}},
+			},
+		},
+	}
+	input := GenerateRecordsInput{
+		Inspector:   &mockContainerInspector{inspections: map[string]container.InspectResponse{"id": inspect}},
+		Containers:  []container.Summary{{ID: "id"}},
+		Zones:       []string{"podman."},
+		LabelPrefix: "com.dokku.coredns-docker",
+	}
+	front := []net.IP{net.ParseIP("10.88.0.10")}
+	back := []net.IP{net.ParseIP("10.89.0.10"), net.ParseIP("2001:db8::10")}
+	want := map[string][]net.IP{
+		"web.frontend.podman.":    front,
+		"public.frontend.podman.": front,
+		"web.backend.podman.":     back,
+		"private.backend.podman.": back,
+	}
+	got, _, ptrs, _, _ := generateRecords(context.Background(), input)
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("records: got %v, want %v", got, want)
+	}
+	if got := ptrs[mustReverseAddr("10.89.0.10")]; !reflect.DeepEqual(got, []string{"web.backend.podman.", "private.backend.podman."}) {
+		t.Fatalf("backend PTR records: %v", got)
+	}
+	input.Networks = []string{"backend"}
+	got, _, _, _, _ = generateRecords(context.Background(), input)
+	want = map[string][]net.IP{"web.podman.": back, "private.podman.": back}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("filtered records: got %v, want %v", got, want)
+	}
+	input.Networks = nil
+	inspect.Config.Labels[input.LabelPrefix+"/cname"] = "example.org"
+	got, _, _, cnames, _ := generateRecords(context.Background(), input)
+	wantCnames := map[string]string{
+		"web.frontend.podman.":    "example.org.",
+		"public.frontend.podman.": "example.org.",
+		"web.backend.podman.":     "example.org.",
+		"private.backend.podman.": "example.org.",
+	}
+	if len(got) != 0 || !reflect.DeepEqual(cnames, wantCnames) {
+		t.Fatalf("CNAME records: got %v, want %v; address records: %v", cnames, wantCnames, got)
+	}
+}
